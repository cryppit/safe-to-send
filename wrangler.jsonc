{
  // Safe to Send hosted API. Keyless, read-only, no storage. Deploy: see RELEASE.md (the founder runs wrangler deploy).
  "name": "safe-to-send-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Rate limiting: the Workers rate-limit binding is approximate (it can leak several times the configured limit),
  // so pair it with a zone WAF rate-limiting rule in the Cloudflare dashboard (see RELEASE.md). No KV/DO is used,
  // keeping the "no storage" promise. Uncomment and set an id when enabling the binding:
  // "ratelimits": [{ "name": "CHECK_RL", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }]
}
